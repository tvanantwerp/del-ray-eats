---
import restaurants from '../data/restaurants.json';

import Card from '../components/card.astro';
import BaseLayout from '../layouts/base.astro';
import { sortSouthToNorth } from '../lib/sort-restaurants';

const ordered = sortSouthToNorth(restaurants);
---

<BaseLayout>
  <h1
    class="text-3xl font-extrabold font-heading text-center mb-8 text-slate-800 dark:text-slate-50"
  >
    Del Ray Eats
  </h1>
  <ul
    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8 items-stretch"
  >
    {
      ordered.map(restaurant => (
        <li>
          <Card restaurant={restaurant} />
        </li>
      ))
    }
  </ul>
</BaseLayout>
